generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  role      String   @default("Agent")
  color     String   @default("indigo")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets        Ticket[]
  replies        TicketReply[]
  projectMembers ProjectMember[]
  notifications  Notification[]
  leaves            Leave[]            @relation("LeaveUser")
  reviewedLeaves    Leave[]            @relation("LeaveReviewer")
  announcements     Announcement[]     @relation("AnnouncementAuthor")
  announcementReads AnnouncementRead[]
  @@map("users")
}

model Leave {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  type         String    @default("Yıllık İzin")
  startDate    DateTime
  endDate      DateTime
  days         Float     @default(1)
  reason       String?
  status       String    @default("Beklemede")
  reviewedById Int?
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([status])
  @@map("leaves")
}

model Announcement {
  id          Int                @id @default(autoincrement())
  title       String
  body        String
  createdById Int
  createdBy   User               @relation("AnnouncementAuthor", fields: [createdById], references: [id])
  requireAck  Boolean            @default(false)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  reads       AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRead {
  id             Int          @id @default(autoincrement())
  announcementId Int
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledged   Boolean      @default(false)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Customer {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  company      String?
  phone        String?
  notes        String?
  password     String?
  monthlyPrice Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tickets   Ticket[]
  projects  Project[]
  companies CustomerCompany[]

  @@map("customers")
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  customers CustomerCompany[]

  @@map("companies")
}

model CustomerCompany {
  id         Int      @id @default(autoincrement())
  customerId Int
  companyId  Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([customerId, companyId])
  @@map("customer_companies")
}

model Ticket {
  id         Int           @id @default(autoincrement())
  subject    String
  body       String
  fromEmail  String
  fromName   String?
  category   String        @default("Genel")
  status     String        @default("Yeni")
  assigneeId Int?
  assignee   User?         @relation(fields: [assigneeId], references: [id])
  customerId Int?
  customer   Customer?     @relation(fields: [customerId], references: [id])
  priority          String        @default("Normal")
  solutionType      String?
  platform          String?
  source            String?       @default("web")
  telegramChatId    String?
  telegramMessageId Int?          @unique
  emailMessageId    String?       @unique
  receivedAt        DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  replies           TicketReply[]
  survey            Survey?

  @@map("tickets")
}

model Survey {
  id       Int             @id @default(autoincrement())
  ticketId Int             @unique
  ticket   Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  token    String          @unique
  sentAt   DateTime        @default(now())
  response SurveyResponse?

  @@map("surveys")
}

model SurveyResponse {
  id          Int      @id @default(autoincrement())
  surveyId    Int      @unique
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  q1          Int
  q2          Int
  q3          Int
  q4          Int
  q5          Int
  comment     String?
  submittedAt DateTime @default(now())

  @@map("survey_responses")
}

model TicketReply {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  body         String
  isInternal   Boolean  @default(false)
  attachments  String?  @default("[]")
  workMinutes  Int?
  solutionType String?
  platform     String?
  createdAt    DateTime @default(now())

  @@map("ticket_replies")
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  status      String          @default("Devam Ediyor")
  customerId  Int?
  customer    Customer?       @relation(fields: [customerId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  steps       ProjectStep[]
  logs        ProjectLog[]
  messages    ProjectMessage[]

  @@map("projects")
}

model ProjectMember {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectStep {
  id        Int           @id @default(autoincrement())
  projectId Int
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int           @default(0)
  status    String        @default("Beklemede")
  tasks     ProjectTask[]

  @@map("project_steps")
}

model ProjectTask {
  id           Int         @id @default(autoincrement())
  stepId       Int
  step         ProjectStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  assigneeId   Int?
  assigneeType String?
  status       String      @default("Beklemede")
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())

  @@map("project_tasks")
}

model ProjectLog {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int?
  userName  String?
  action    String
  createdAt DateTime @default(now())

  @@map("project_logs")
}

model ProjectMessage {
  id          Int      @id @default(autoincrement())
  projectId   Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      Int?
  userName    String?
  userType    String   @default("user")
  body        String
  attachments String?  @default("[]")
  createdAt   DateTime @default(now())

  @@map("project_messages")
}

